# --- Twilio credentials (real SMS dispatch) --------------------------------
# Fill these in with values from https://console.twilio.com
# then rename this file to `.env` (no extension prefix).
# The app auto-loads it via python-dotenv.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15555555555

# Default recipient for critical alerts (E.164 format)
EMERGENCY_RECIPIENT=+15555555556

# --- Model options ---------------------------------------------------------
# Which YOLO weights to auto-download.  Options:
#   yolov8n.pt   (fastest, ~6 MB)
#   yolov8s.pt   (~22 MB)
#   yolov8m.pt   (~50 MB, best accuracy vs speed on GPU)
#   yolov8l.pt   (~87 MB)
YOLO_WEIGHTS=yolov8n.pt
